# CampusAI Advisor local configuration
# Copy this file to .env locally and replace placeholders with real values.
# Do not commit .env or real API keys.

GROQ_API_KEY=your_primary_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Local RAG defaults.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
VECTOR_STORE_PROVIDER=local
VECTOR_STORE_PATH=data/vector_db
CHROMA_COLLECTION=campusai_documents
RAW_DATA_DIR=data/raw
CHUNK_SIZE=800
CHUNK_OVERLAP=150

GROQ_TIMEOUT_SECONDS=30
GROQ_MIN_SECONDS_BETWEEN_REQUESTS=3
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=900
RAG_TOP_K=5

# Optional V2.3 backend mode.
# Leave unset for normal local Streamlit and Streamlit Cloud direct-RAG mode.
# Docker Compose should set this in the Streamlit service:
# CAMPUSAI_API_BASE_URL=http://fastapi-backend:8000
CAMPUSAI_API_BASE_URL=
